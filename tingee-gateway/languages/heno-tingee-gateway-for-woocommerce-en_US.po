#: includes/class-tingee-webhook.php:85
msgid ""
"Webhook nhận được nhưng Secret Token chưa cấu hình. Vào WooCommerce → "
"Settings → Payments → Tingee để điền Secret Token."
msgstr ""
"Webhook received but Secret Token is not configured. Go to WooCommerce → "
"Settings → Payments → Tingee to enter the Secret Token."

#: includes/class-tingee-webhook.php:97
msgid "Webhook bị từ chối: thiếu header x-request-timestamp hoặc x-signature."
msgstr "Webhook rejected: missing x-request-timestamp or x-signature header."

#. translators: %s: 4 ký tự đầu của signature nhận được
#: includes/class-tingee-webhook.php:108
#, php-format
msgid ""
"Webhook bị từ chối: chữ ký không hợp lệ. Signature nhận được bắt đầu bằng: %s"
msgstr ""
"Webhook rejected: invalid signature. Received signature starts with: %s"

#. translators: 1: IP address của server Tingee, 2: timestamp từ header
#: includes/class-tingee-webhook.php:120
#, php-format
msgid "Webhook hợp lệ nhận được. IP: %1$s. Timestamp: %2$s."
msgstr "Valid webhook received. IP: %1$s. Timestamp: %2$s."

#: includes/class-tingee-webhook.php:133
msgid "Webhook payload không hợp lệ (không phải JSON object)."
msgstr "Invalid webhook payload (not a JSON object)."

#. translators: %s: billId từ Tingee
#: includes/class-tingee-webhook.php:188
#, php-format
msgid "Webhook billId=%s: không tìm thấy đơn hàng tương ứng."
msgstr "Webhook billId=%s: no matching order found."

#: includes/class-tingee-webhook.php:203
msgid "Webhook thiếu cả billId lẫn content — không thể xác định đơn hàng."
msgstr "Webhook missing both billId and content — unable to identify order."

#. translators: %s: nội dung chuyển khoản
#: includes/class-tingee-webhook.php:223
#, php-format
msgid ""
"Webhook Static QR: không tìm được đơn on-hold nào với nội dung CK \"%s\". "
"Khách có thể đã sửa nội dung CK — cần xử lý thủ công."
msgstr ""
"Webhook Static QR: no on-hold order found with transfer reference \"%s\". "
"Customer may have modified the reference — manual processing required."

#. translators: 1: order identifier (billId=... hoặc content=...), 2: transaction code
#: includes/class-tingee-webhook.php:249
#, php-format
msgid ""
"Webhook Mode A %1$s transactionCode=%2$s: đã xử lý trước đó, bỏ qua "
"(idempotency)."
msgstr ""
"Webhook Mode A %1$s transactionCode=%2$s: already processed, skipping "
"(idempotency)."

#. translators: 1: số tiền nhận, 2: mã giao dịch, 3: nội dung CK, 4: thời gian GD
#: includes/class-tingee-webhook.php:279
#, php-format
msgid ""
"Tingee xác nhận thanh toán thành công. Số tiền: %1$s ₫. Mã GD: %2$s. Nội "
"dung: %3$s. Thời gian GD: %4$s."
msgstr ""
"Tingee confirmed successful payment. Amount: %1$s VND. Transaction code: %2$s. "
"Reference: %3$s. Transaction time: %4$s."

#. translators: 1: order identifier, 2: transaction code, 3: WooCommerce order ID
#: includes/class-tingee-webhook.php:293
#, php-format
msgid ""
"Webhook Mode A %1$s transactionCode=%2$s: thanh toán thành công. Đơn #%3$d → "
"Processing."
msgstr ""
"Webhook Mode A %1$s transactionCode=%2$s: payment successful. Order #%3$d → "
"Processing."

#. translators: 1: số tiền nhận, 2: số tiền cần, 3: mã giao dịch
#: includes/class-tingee-webhook.php:305
#, php-format
msgid ""
"[Cảnh báo] Tingee nhận thanh toán THIẾU TIỀN. Nhận: %1$s ₫ / Cần: %2$s ₫. Mã "
"GD: %3$s. Đơn giữ On-Hold — vui lòng xử lý thủ công."
msgstr ""
"[Warning] Tingee received UNDERPAYMENT. Received: %1$s VND / Required: %2$s VND. "
"Transaction code: %3$s. Order kept On-Hold — please process manually."

#. translators: 1: order identifier, 2: received amount, 3: expected amount, 4: WooCommerce order ID
#: includes/class-tingee-webhook.php:317
#, php-format
msgid ""
"Webhook Mode A %1$s: THIẾU TIỀN. Nhận %2$d / Cần %3$d. Đơn #%4$d giữ On-Hold."
msgstr ""
"Webhook Mode A %1$s: UNDERPAYMENT. Received %2$d / Required %3$d. Order #%4$d kept On-Hold."

#. translators: %s: Tingee order ID
#: includes/class-tingee-webhook.php:376
#, php-format
msgid "Webhook Mode B orderId=%s: không tìm thấy đơn hàng."
msgstr "Webhook Mode B orderId=%s: order not found."

#. translators: %s: webhook request ID
#: includes/class-tingee-webhook.php:396
#, php-format
msgid "Webhook Mode B requestId=%s: đã xử lý, bỏ qua (idempotency)."
msgstr "Webhook Mode B requestId=%s: already processed, skipping (idempotency)."

#. translators: 1: status, 2: statusCode
#: includes/class-tingee-webhook.php:411
#, php-format
msgid ""
"Tingee (Chế độ B) thông báo: trạng thái \"%1$s\" (statusCode: %2$s). Đơn "
"không được thanh toán."
msgstr ""
"Tingee (Mode B) notification: status \"%1$s\" (statusCode: %2$s). Order not paid."

#. translators: 1: Tingee order ID, 2: status, 3: statusCode
#: includes/class-tingee-webhook.php:422
#, php-format
msgid ""
"Webhook Mode B orderId=%1$s: status=%2$s, statusCode=%3$s — không phải "
"success."
msgstr ""
"Webhook Mode B orderId=%1$s: status=%2$s, statusCode=%3$s — not successful."

#. translators: 1: số tiền, 2: phương thức, 3: thời gian
#: includes/class-tingee-webhook.php:448
#, php-format
msgid ""
"Tingee (Chế độ B) xác nhận thanh toán thành công. Số tiền: %1$s ₫. Phương "
"thức: %2$s. Thời gian: %3$s."
msgstr ""
"Tingee (Mode B) confirmed successful payment. Amount: %1$s VND. Method: %2$s. Time: %3$s."

#. translators: 1: Tingee order ID, 2: WooCommerce order ID
#: includes/class-tingee-webhook.php:462
#, php-format
msgid ""
"Webhook Mode B orderId=%1$s: thanh toán thành công. Đơn #%2$d → Processing."
msgstr ""
"Webhook Mode B orderId=%1$s: payment successful. Order #%2$d → Processing."

#. translators: 1: số tiền nhận, 2: số tiền cần
#: includes/class-tingee-webhook.php:473
#, php-format
msgid ""
"[Cảnh báo] Tingee (Chế độ B) nhận THIẾU TIỀN. Nhận: %1$s ₫ / Cần: %2$s ₫. "
"Đơn giữ On-Hold — vui lòng xử lý thủ công."
msgstr ""
"[Warning] Tingee (Mode B) received UNDERPAYMENT. Received: %1$s VND / Required: %2$s VND. "
