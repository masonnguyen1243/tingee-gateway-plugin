msgstr ""
"How to display the bank name in the transfer information table on the thank-you page."

#: includes/class-tingee-gateway.php:296
msgid "Cả tên đầy đủ và viết tắt"
msgstr "Both full name and abbreviation"

#: includes/class-tingee-gateway.php:297
msgid "Chỉ tên đầy đủ"
msgstr "Full name only"

#: includes/class-tingee-gateway.php:298
msgid "Chỉ tên viết tắt"
